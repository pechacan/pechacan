    <div class="footer-bottom">
      <span>© Pechacan — educación canina desde el vínculo</span>
      <span>Hecho con calma</span>
    </div>
  </div>
</footer>

<a class="whatsapp-float" href="https://wa.me/34636882884?text=Hola%20Pechacan%2C%20quiero%20contaros%20mi%20caso" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A8.86 8.86 0 0012.02 3a8.94 8.94 0 00-7.77 13.4L3 21l4.72-1.24a8.93 8.93 0 004.28 1.09h.01a8.94 8.94 0 008.93-8.94 8.86 8.86 0 00-3.34-6.6zM12.02 19.4h-.01a7.4 7.4 0 01-3.78-1.04l-.27-.16-2.8.74.75-2.73-.18-.28a7.43 7.43 0 01-1.14-3.96 7.44 7.44 0 0114.88-.02 7.45 7.45 0 01-7.45 7.45zm4.08-5.58c-.22-.11-1.32-.65-1.53-.73-.21-.08-.36-.11-.51.11-.15.22-.58.73-.71.88-.13.15-.26.16-.48.05a6.1 6.1 0 01-1.8-1.11 6.75 6.75 0 01-1.24-1.55c-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.15-.22.22-.37.07-.15.04-.28-.02-.39-.06-.11-.51-1.23-.7-1.68-.18-.44-.37-.38-.51-.39h-.44c-.15 0-.39.06-.6.28-.2.22-.79.77-.79 1.88s.81 2.18.92 2.33c.11.15 1.6 2.44 3.87 3.42.54.23.96.37 1.29.48.54.17 1.03.15 1.42.09.43-.06 1.32-.54 1.51-1.06.19-.52.19-.96.13-1.06-.06-.1-.2-.15-.42-.26z"/></svg>
</a>

<div class="modal-overlay" id="confirmModal" hidden>
  <div class="modal-box">
    <button class="modal-close" id="modalClose" aria-label="Cerrar">✕</button>
    <div class="modal-icon">✓</div>
    <h3>Hemos recibido tu consulta</h3>
    <p>Nuestro equipo te contactará muy pronto. Si quieres que conversemos cuanto antes, puedes escribirnos por WhatsApp a <a href="https://wa.me/34636882884" target="_blank" rel="noopener">+34 636 88 28 84</a>.</p>
    <a class="btn btn-mostaza" href="https://wa.me/34636882884" target="_blank" rel="noopener">Escribir por WhatsApp</a>
  </div>
</div>

<script>
(function(){
  var pages = document.querySelectorAll('.page');
  var navBtns = document.querySelectorAll('[data-nav]');
  var navLinksEl = document.getElementById('navLinks');
  var burger = document.getElementById('burgerBtn');
  var interesSelect = document.getElementById('f-interes');

  function showPage(id, interes){
    var found = false;
    pages.forEach(function(p){
      var match = p.id === 'page-' + id;
      p.classList.toggle('active', match);
      if(match) found = true;
    });
    if(!found){ id = 'home'; document.getElementById('page-home').classList.add('active'); }
    document.querySelectorAll('.navlink').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-nav') === id);
    });
    navLinksEl.classList.remove('open');
    window.scrollTo({top:0, behavior:'auto'});
    if(interes && interesSelect){
      Array.from(interesSelect.options).forEach(function(opt){
        if(opt.text === interes){ interesSelect.value = interes; }
      });
    }
  }

  navBtns.forEach(function(btn){
    btn.addEventListener('click', function(e){
      var target = btn.getAttribute('data-nav');
      if(!target) return;
      e.preventDefault();
      var interes = btn.getAttribute('data-interes');
      window.location.hash = target;
      showPage(target, interes);
    });
  });

  burger.addEventListener('click', function(){
    navLinksEl.classList.toggle('open');
  });

  window.addEventListener('hashchange', function(){
    var id = window.location.hash.replace('#','') || 'home';
    showPage(id);
  });

  var initial = window.location.hash.replace('#','') || 'home';
  showPage(initial);

  // modalidad toggle (educacion)
  var modBtns = document.querySelectorAll('.mod-btn');
  modBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      var mod = btn.getAttribute('data-mod');
      modBtns.forEach(function(b){ b.classList.toggle('active', b === btn); });
      document.getElementById('mod-online').classList.toggle('active', mod === 'online');
      document.getElementById('mod-presencial').classList.toggle('active', mod === 'presencial');
    });
  });

  // checklist "es esta masterclass para ti"
  var checkInputs = document.querySelectorAll('#checkList input[type="checkbox"]');
  var checkResult = document.getElementById('checkResult');
  var checkResultText = document.getElementById('checkResultText');
  var checkResultTag = document.getElementById('checkResultTag');
  function joinFrases(arr){
    if(arr.length === 1) return arr[0];
    return arr.slice(0, -1).join('; ') + '; y ' + arr[arr.length - 1];
  }
  function updateCheckResult(){
    var insights = [];
    checkInputs.forEach(function(input){
      var item = input.closest('.check-item');
      item.classList.toggle('active', input.checked);
      if(input.checked) insights.push(input.getAttribute('data-insight'));
    });
    if(insights.length === 0){
      checkResult.hidden = true;
      return;
    }
    var intro, tag;
    if(insights.length === 1){
      tag = 'Esto es lo que nos cuentas';
      intro = 'Por lo que nos cuentas, ';
    } else if(insights.length === 2){
      tag = 'Dos cosas que van de la mano';
      intro = 'Nos cuentas dos cosas que suelen ir juntas: ';
    } else {
      tag = 'Tiene sentido que os sintáis desbordados';
      intro = 'Nos cuentas varias cosas a la vez: ';
    }
    checkResultTag.textContent = tag;
    checkResultText.textContent = intro + joinFrases(insights) + '. Todo esto se trabaja, paso a paso, en la masterclass.';
    checkResult.hidden = false;
  }
  checkInputs.forEach(function(input){
    input.addEventListener('change', updateCheckResult);
  });

  // ruta "cómo funciona" — revelado al entrar en pantalla
  var ruta = document.getElementById('ruta');
  if(ruta && 'IntersectionObserver' in window){
    var rutaObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          ruta.classList.add('visible');
          rutaObserver.unobserve(ruta);
        }
      });
    }, {threshold:.3});
    rutaObserver.observe(ruta);
  } else if(ruta){
    ruta.classList.add('visible');
  }

  // quiz interactivo home
  var quizData = {
    convivencia: {
      tag: 'Te recomendamos',
      title: 'Sesiones de educación canina',
      desc: 'Empezamos por observar qué le pasa a tu perro y trabajar la relación día a día, online o presencial en Algeciras.',
      nav: 'educacion'
    },
    reactividad: {
      tag: 'Te recomendamos',
      title: 'Masterclass de reactividad',
      desc: 'Un plan progresivo de 4 semanas para entender los tirones, los ladridos y el miedo, y volver a pasear en calma.',
      nav: 'reactividad'
    },
    adopcion: {
      tag: 'Te recomendamos',
      title: 'Concierge para adopción',
      desc: 'Te acompañamos a elegir el perfil de perro compatible con tu casa y a preparar bien la llegada.',
      nav: 'adopcion'
    }
  };
  var quizOpts = document.querySelectorAll('.quiz-opt');
  var quizResult = document.getElementById('quizResult');
  quizOpts.forEach(function(opt){
    opt.addEventListener('click', function(){
      quizOpts.forEach(function(o){ o.classList.toggle('active', o === opt); });
      var d = quizData[opt.getAttribute('data-situacion')];
      document.getElementById('quizResultTag').textContent = d.tag;
      document.getElementById('quizResultTitle').textContent = d.title;
      document.getElementById('quizResultDesc').textContent = d.desc;
      var btn = document.getElementById('quizResultBtn');
      btn.setAttribute('data-nav', d.nav);
      quizResult.hidden = false;
    });
  });
  document.getElementById('quizResultBtn').addEventListener('click', function(){
    var target = this.getAttribute('data-nav');
    window.location.hash = target;
    showPage(target);
  });

  // contact form -> mailto + confirmación
  var form = document.getElementById('contactForm');
  var confirmModal = document.getElementById('confirmModal');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var nombre = document.getElementById('f-nombre').value;
    var email = document.getElementById('f-email').value;
    var interes = document.getElementById('f-interes').value;
    var mensaje = document.getElementById('f-mensaje').value;
    var subject = encodeURIComponent('Contacto desde la web — ' + interes);
    var body = encodeURIComponent(
      'Nombre: ' + nombre + '\n' +
      'Email: ' + email + '\n' +
      'Interés: ' + interes + '\n\n' +
      'Mensaje:\n' + mensaje
    );
    window.location.href = 'mailto:pechacanmarketing@gmail.com?subject=' + subject + '&body=' + body;
    confirmModal.hidden = false;
    document.body.style.overflow = 'hidden';
  });

  function closeModal(){
    confirmModal.hidden = true;
    document.body.style.overflow = '';
  }
  document.getElementById('modalClose').addEventListener('click', closeModal);
  confirmModal.addEventListener('click', function(e){
    if(e.target === confirmModal) closeModal();
  });
})();
</script>

</body>
</html>
